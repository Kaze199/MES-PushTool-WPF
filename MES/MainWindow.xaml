<Window x:Class="MESPushTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES推送工具" Height="680" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MES接口配置 -->
        <GroupBox Grid.Row="0" Header="MES接口配置" Margin="0,0,0,6">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="地址:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="txtMesUrl" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Token:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" Name="txtToken" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="类型:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="5" Name="txtWsType" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="编号:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="7" Name="txtWsNo" Margin="0,2" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="工单号:" VerticalAlignment="Center" Margin="0,4,4,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="txtWorkOrder" Margin="0,4,0,2" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 通讯配置 -->
        <GroupBox Grid.Row="1" Header="通讯配置" Margin="0,0,0,6">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Name="rbSerial" Content="串口" VerticalAlignment="Center" Margin="0,0,8,0" Checked="CommMode_Checked" Unchecked="CommMode_Checked"/>
                <RadioButton Grid.Column="1" Name="rbTcp" Content="TCP" VerticalAlignment="Center" Margin="0,0,8,0" Checked="CommMode_Checked" Unchecked="CommMode_Checked"/>

                <TextBlock Grid.Column="2" Text="串口:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox Grid.Column="3" Name="cmbSerialPort" Width="70" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="波特率:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Column="5" Name="txtBaudRate" Width="60" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="数据位:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Column="7" Name="txtDataBits" Width="30" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="校验:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox Grid.Column="9" Name="cmbParity" Width="60" Margin="0,2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="10" Text="停止位:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox Grid.Column="11" Name="cmbStopBits" Width="50" Margin="0,2" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="12" Text="TCP端口:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox Grid.Column="13" Name="txtTcpPort" Width="60" Margin="0,2" VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Name="btnSaveConfig" Content="保存配置" Width="90" Margin="0,0,8,0" Click="btnSaveConfig_Click"/>
            <Button Name="btnStart" Content="启动监听" Width="90" Margin="0,0,8,0" Click="btnStart_Click"/>
            <Button Name="btnStop" Content="停止监听" Width="90" Margin="0,0,8,0" Click="btnStop_Click" IsEnabled="False"/>
            <Button Name="btnManualPush" Content="手动推送" Width="90" Margin="0,0,8,0" Click="btnManualPush_Click"/>
            <Button Name="btnClear" Content="清空显示" Width="90" Margin="0,0,8,0" Click="btnClear_Click"/>
        </StackPanel>

        <!-- 推送内容与结果 -->
        <GroupBox Grid.Row="3" Header="推送内容与结果">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="接收数据:" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Name="txtReceive" Margin="0,2,0,6" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" IsReadOnly="True" Background="#F5F5F5"/>
                <TextBlock Grid.Row="2" Text="推送结果:" FontWeight="Bold"/>
                <TextBox Grid.Row="3" Name="txtResult" Margin="0,2,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" IsReadOnly="True" Background="#F5F5F5"/>
            </Grid>
        </GroupBox>

        <!-- 日志查询 -->
        <GroupBox Grid.Row="4" Header="日志查询" Margin="0,6,0,0">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="日期:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker Grid.Column="1" Name="dpLogDate" Width="120" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Name="btnQueryLog" Content="查询" Width="60" Margin="0,0,8,0" Click="btnQueryLog_Click"/>
                <Button Grid.Column="3" Name="btnExportLog" Content="导出" Width="60" Margin="0,0,8,0" Click="btnExportLog_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
